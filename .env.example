# Salin menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables
# Ambil nilainya di Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
# Kunci rahasia: hanya dipakai di server. Jangan beri awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# Opsional: server TURN agar video tetap tersambung di jaringan ketat (kantor/kampus)
# Contoh format: turn:turn.contoh.id:3478
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
